#!/bin/bash

COMPOSE_DIR="${TRIM_APPDEST}/docker"
COMPOSE_FILE="${COMPOSE_DIR}/docker-compose.yaml"
CONTAINER_NAME="moontvplus"
IMAGE="ghcr.io/mtvpls/moontvplus:latest"
IMAGE_TAR="${COMPOSE_DIR}/moontvplus-image.tar"
IMAGE_MIRRORS="ghcr.nju.edu.cn ghcr.m.daocloud.io"

# 优先用内嵌镜像，其次按镜像源顺序拉取（国内镜像源在前，ghcr.io 兜底）
ensure_image() {
    if [ -f "${IMAGE_TAR}" ]; then
        install_log "加载内嵌镜像 ${IMAGE_TAR}"
        docker load -i "${IMAGE_TAR}" 2>&1 | install_log
        return 0
    fi
    if [ "$1" != "force" ] && docker image inspect "${IMAGE}" >/dev/null 2>&1; then
        install_log "镜像已存在，跳过拉取"
        return 0
    fi

    for host in ${IMAGE_MIRRORS} ""; do
        if [ -n "${host}" ]; then
            ref="${host}/mtvpls/moontvplus:latest"
        else
            ref="${IMAGE}"
        fi
        install_log "拉取镜像 ${ref}"
        if timeout 300 docker pull "${ref}" >> "${LOG_FILE}" 2>&1; then
            if docker image inspect "${ref}" >/dev/null 2>&1; then
                [ "${ref}" != "${IMAGE}" ] && docker tag "${ref}" "${IMAGE}"
                install_log "镜像就绪 ${ref}"
                return 0
            fi
        fi
        install_log "镜像源 ${host:-ghcr.io} 不可用，尝试下一个"
    done

    install_log "所有镜像源均拉取失败"
    return 1
}

# 让容器内的运行 UID/GID 与宿主机数据目录属主一致，否则激活层写 config.json 会失败
prepare_data_dirs() {
    mkdir -p "${TRIM_PKGVAR}/data" "${TRIM_PKGVAR}/downloads" 2>/dev/null || true
    MOUNT_UID="$(stat -c '%u' "${TRIM_PKGVAR}/data" 2>/dev/null || echo 1001)"
    MOUNT_GID="$(stat -c '%g' "${TRIM_PKGVAR}/data" 2>/dev/null || echo 1001)"
    chmod -R u+rwX,go+rwX "${TRIM_PKGVAR}/data" "${TRIM_PKGVAR}/downloads" 2>/dev/null || true
    export MOUNT_UID MOUNT_GID
    install_log "数据目录 ${TRIM_PKGVAR}/data uid=${MOUNT_UID} gid=${MOUNT_GID}"
}

compose_up() {
    local port="${wizard_port:-${TRIM_SERVICE_PORT:-3000}}"
    cd "${COMPOSE_DIR}" || error_exit "找不到应用目录 ${COMPOSE_DIR}"
    prepare_data_dirs
    install_log "启动容器，端口 ${port}"
    TRIM_SERVICE_PORT="${port}" MOUNT_UID="${MOUNT_UID}" MOUNT_GID="${MOUNT_GID}" \
        docker compose -f "${COMPOSE_FILE}" up -d --remove-orphans 2>&1 | install_log
}

compose_down() {
    if [ -f "${COMPOSE_FILE}" ]; then
        cd "${COMPOSE_DIR}" || return 0
        docker compose -f "${COMPOSE_FILE}" down --remove-orphans 2>&1 | install_log
    fi
}

wait_running() {
    local i=0
    while [ "${i}" -lt 60 ]; do
        if [ "$(docker inspect -f '{{.State.Running}}' "${CONTAINER_NAME}" 2>/dev/null)" = "true" ]; then
            install_log "容器 ${CONTAINER_NAME} 已运行"
            return 0
        fi
        i=$((i + 1))
        sleep 2
    done
    install_log "容器启动超时，输出最近日志："
    docker logs --tail 60 "${CONTAINER_NAME}" 2>&1 | install_log
    return 1
}

service_postinst() {
    prepare_data_dirs
    ensure_image || error_exit "无法获取 MoonTVPlus 镜像，请检查网络后重试安装"
    compose_up
    wait_running
}

service_postupgrade() {
    prepare_data_dirs
    ensure_image
    compose_up
    wait_running
}

service_preuninst() {
    compose_down
}

service_postconfig() {
    compose_up
    wait_running
}
